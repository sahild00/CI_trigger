            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -euxo pipefail\n\n# Save installation output for troubleshooting\nexec \u003e \u003e(tee /var/log/user-data.log | logger -t user-data -s 2\u003e/dev/console) 2\u003e\u00261\n\n# Install Apache\ndnf install -y httpd\n\n# Create the webpage\ncat \u003e /var/www/html/index.html \u003c\u003c'HTML'\n\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n  \u003ctitle\u003eTerraform Web Server\u003c/title\u003e\n  \u003cstyle\u003e\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: Arial, sans-serif;\n      background: #f3f6fa;\n    }\n\n    .card {\n      padding: 40px;\n      text-align: center;\n      background: white;\n      border-radius: 12px;\n      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);\n    }\n\n    h1 {\n      color: #146eb4;\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003ch1\u003eTerraform Web Server Project\u003c/h1\u003e\n    \u003cp\u003eDeployed successfully by Sahil Dogra on AWS.\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/body\u003e\n\u003c/html\u003e\nHTML\n\n# Start Apache now and automatically after reboot\nsystemctl enable --now httpd\n\n# Confirm Apache is running\nsystemctl status httpd --no-pager\ncurl -I http://localhost",
